# Copy to .env and fill in real values. Never commit the real .env file.

# MySQL
DATABASE_URL=mysql+pymysql://freeboard_user:changeme@localhost:3306/freeboard

# Google OAuth (from console.cloud.google.com > Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Signs the login JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-64-char-hex-string
JWT_EXPIRE_MINUTES=10080

# Where the frontend is served from — used for CORS + post-login redirect
FRONTEND_ORIGIN=http://localhost:5500

ENV=development
